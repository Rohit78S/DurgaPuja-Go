# Dependencies
# This folder is large and can be regenerated by running "npm install".
/node_modules

# Secrets
# This file contains your secret database password and Google Client ID.
# It MUST be ignored to prevent security leaks.
.env

# Logs
# Optional: Ignores error logs from npm.
npm-debug.log*
yarn-error.log*
# Add content to .gitignore
@"
# Dependencies
/node_modules

# Secrets
.env

# Logs
npm-debug.log*
yarn-error.log*

# Build outputs
/build
/dist

# OS files
.DS_Store
Thumbs.db
"@ | Out-File -FilePath ".gitignore" -Encoding utf8
